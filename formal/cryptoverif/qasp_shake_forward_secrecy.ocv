(* ===================================================================== *)
(* QASP-Shake — Forward Secrecy Variant                                  *)
(*                                                                       *)
(* Extends the main model with key compromise oracles.                   *)
(* Proves that session keys remain secret even after long-term           *)
(* signing keys are revealed to the adversary.                           *)
(*                                                                       *)
(* Forward secrecy holds because KEM keys are ephemeral:                 *)
(*   - Each session generates fresh kem_seed_C / kem_seed_S             *)
(*   - Compromising sig_sk does not reveal kem_sk                        *)
(*   - Session key depends only on KEM shared secrets                    *)
(*                                                                       *)
(* CryptoVerif models this via public_vars: the secrecy query holds      *)
(* even when sig_sk_C and sig_sk_S are given to the adversary.          *)
(*                                                                       *)
(* Reference:                                                            *)
(*   formal/proverif/qasp_shake.pv — phase-based forward secrecy model  *)
(* ===================================================================== *)

(* ---- Expand crypto library macros ---- *)

expand HybridKEM(kemseed, kem_skey, kem_pkey, kem_ciphertext, kem_ss,
                 kem_skgen, kem_pkgen, kem_enc, kem_dec, kem_ss_of,
                 Pkem).

expand MLDSA65(sigkeyseed, sig_skey, sig_pkey, signature,
               sig_skgen, sig_pkgen, sig_sign, sig_verify,
               Psig).

expand HKDF_SHA384(hkdf_key, hkdf_output,
                   hkdf,
                   Phkdf).

expand CollisionResistantHash(hash_output,
                              cr_hash,
                              Pcoll).


(* ===================================================================== *)
(* Protocol-specific types and constants                                 *)
(* ===================================================================== *)

type nonce_t [large,fixed].
type suite_id [fixed].

const SUITE_HYBRID: suite_id.
const QASP_INFO: bitstring.

param Nsessions.


(* ===================================================================== *)
(* Transcript construction (same as main model)                          *)
(* ===================================================================== *)

fun build_server_transcript(
  nonce_t, kem_pkey, sig_pkey, suite_id,
  nonce_t, kem_ciphertext, kem_pkey, sig_pkey, suite_id
): bitstring [data].

fun build_client_transcript(
  nonce_t, kem_pkey, sig_pkey, suite_id,
  nonce_t, kem_ciphertext, kem_pkey, sig_pkey, suite_id,
  signature
): bitstring [data].

fun combine_ss(kem_ss, kem_ss): hkdf_key [data].
fun concat_nonces(nonce_t, nonce_t): bitstring [data].


(* ===================================================================== *)
(* Events                                                                *)
(* ===================================================================== *)

event ClientStarted(sig_pkey, sig_pkey).
event ServerStarted(sig_pkey, sig_pkey).
event ClientFinished(sig_pkey, sig_pkey, hkdf_output).
event ServerFinished(sig_pkey, sig_pkey, hkdf_output).


(* ===================================================================== *)
(* Forward secrecy queries                                               *)
(*                                                                       *)
(* public_vars declares that sig_sk_C and sig_sk_S are known to the     *)
(* adversary. The session key must still be secret.                      *)
(* ===================================================================== *)

(* Q1-FS: Client session key secrecy under key compromise *)
query secret session_key_C public_vars sig_sk_C_pub, sig_sk_S_pub.

(* Q2-FS: Server session key secrecy under key compromise *)
query secret session_key_S public_vars sig_sk_C_pub, sig_sk_S_pub.


(* ===================================================================== *)
(* Tables and channel                                                    *)
(* ===================================================================== *)

table client_sessions(sig_pkey, sig_pkey, hkdf_output).
table server_sessions(sig_pkey, sig_pkey, hkdf_output).

channel c.


(* ===================================================================== *)
(* Client process (identical to main model)                              *)
(* ===================================================================== *)

let Client(sig_seed_C: sigkeyseed, sig_pk_S: sig_pkey) =
  new kem_seed_C: kemseed;
  let kem_sk_C: kem_skey = kem_skgen(kem_seed_C) in
  let kem_pk_C: kem_pkey = kem_pkgen(kem_seed_C) in

  let sig_sk_C: sig_skey = sig_skgen(sig_seed_C) in
  let sig_pk_C: sig_pkey = sig_pkgen(sig_seed_C) in

  new client_nonce: nonce_t;

  event ClientStarted(sig_pk_C, sig_pk_S);

  out(c, (client_nonce, kem_pk_C, sig_pk_C, SUITE_HYBRID));

  in(c, (
    server_nonce: nonce_t,
    kem_ct_S: kem_ciphertext,
    kem_pk_S: kem_pkey,
    srv_sig_pk: sig_pkey,
    selected_suite: suite_id,
    server_sig: signature
  ));

  if srv_sig_pk = sig_pk_S then

  let t_server: bitstring = build_server_transcript(
    client_nonce, kem_pk_C, sig_pk_C, SUITE_HYBRID,
    server_nonce, kem_ct_S, kem_pk_S, srv_sig_pk, selected_suite
  ) in
  if sig_verify(srv_sig_pk, t_server, server_sig) = true then

  let ss_S: kem_ss = kem_dec(kem_sk_C, kem_ct_S) in

  new kem_enc_seed_C: kem_enc_seed;
  let kem_ct_C: kem_ciphertext = kem_enc(kem_enc_seed_C, kem_pk_S) in
  let ss_C: kem_ss = kem_ss_of(kem_enc_seed_C) in

  let t_client: bitstring = build_client_transcript(
    client_nonce, kem_pk_C, sig_pk_C, SUITE_HYBRID,
    server_nonce, kem_ct_S, kem_pk_S, srv_sig_pk, selected_suite,
    server_sig
  ) in
  let client_sig: signature = sig_sign(sig_sk_C, t_client) in

  out(c, (kem_ct_C, client_sig));

  let combined: hkdf_key = combine_ss(ss_S, ss_C) in
  let salt: bitstring = concat_nonces(client_nonce, server_nonce) in
  let session_key_C: hkdf_output = hkdf(combined, salt, QASP_INFO) in

  event ClientFinished(sig_pk_C, sig_pk_S, session_key_C);
  insert client_sessions(sig_pk_C, sig_pk_S, session_key_C);
  0.


(* ===================================================================== *)
(* Server process (identical to main model)                              *)
(* ===================================================================== *)

let Server(sig_seed_S: sigkeyseed, sig_pk_C: sig_pkey) =
  in(c, (
    client_nonce: nonce_t,
    kem_pk_C: kem_pkey,
    cli_sig_pk: sig_pkey,
    offered_suite: suite_id
  ));

  new kem_seed_S: kemseed;
  let kem_sk_S: kem_skey = kem_skgen(kem_seed_S) in
  let kem_pk_S: kem_pkey = kem_pkgen(kem_seed_S) in

  let sig_sk_S: sig_skey = sig_skgen(sig_seed_S) in
  let sig_pk_S: sig_pkey = sig_pkgen(sig_seed_S) in

  let selected_suite: suite_id = offered_suite in

  event ServerStarted(sig_pk_S, cli_sig_pk);

  new server_nonce: nonce_t;

  new kem_enc_seed_S: kem_enc_seed;
  let kem_ct_S: kem_ciphertext = kem_enc(kem_enc_seed_S, kem_pk_C) in
  let ss_S: kem_ss = kem_ss_of(kem_enc_seed_S) in

  let t_server: bitstring = build_server_transcript(
    client_nonce, kem_pk_C, cli_sig_pk, offered_suite,
    server_nonce, kem_ct_S, kem_pk_S, sig_pk_S, selected_suite
  ) in
  let server_sig: signature = sig_sign(sig_sk_S, t_server) in

  out(c, (
    server_nonce, kem_ct_S, kem_pk_S, sig_pk_S,
    selected_suite, server_sig
  ));

  in(c, (
    kem_ct_C: kem_ciphertext,
    client_sig: signature
  ));

  if cli_sig_pk = sig_pk_C then

  let t_client: bitstring = build_client_transcript(
    client_nonce, kem_pk_C, cli_sig_pk, offered_suite,
    server_nonce, kem_ct_S, kem_pk_S, sig_pk_S, selected_suite,
    server_sig
  ) in
  if sig_verify(cli_sig_pk, t_client, client_sig) = true then

  let ss_C: kem_ss = kem_dec(kem_sk_S, kem_ct_C) in

  let combined: hkdf_key = combine_ss(ss_S, ss_C) in
  let salt: bitstring = concat_nonces(client_nonce, server_nonce) in
  let session_key_S: hkdf_output = hkdf(combined, salt, QASP_INFO) in

  event ServerFinished(sig_pk_S, sig_pk_C, session_key_S);
  insert server_sessions(sig_pk_S, sig_pk_C, session_key_S);
  0.


(* ===================================================================== *)
(* Main process with key compromise                                      *)
(*                                                                       *)
(* CompromiseClient and CompromiseServer oracles reveal the long-term    *)
(* signing secret keys to the adversary, modeling post-compromise.       *)
(* ===================================================================== *)

process
  new sig_seed_C: sigkeyseed;
  new sig_seed_S: sigkeyseed;

  let sig_pk_C: sig_pkey = sig_pkgen(sig_seed_C) in
  let sig_pk_S: sig_pkey = sig_pkgen(sig_seed_S) in

  (* Compute signing secret keys for compromise *)
  let sig_sk_C_pub: sig_skey = sig_skgen(sig_seed_C) in
  let sig_sk_S_pub: sig_skey = sig_skgen(sig_seed_S) in

  (* Publish signing public keys *)
  out(c, sig_pk_C);
  out(c, sig_pk_S);

  (
    (! i_C <= Nsessions Client(sig_seed_C, sig_pk_S))
  |
    (! i_S <= Nsessions Server(sig_seed_S, sig_pk_C))
  )


(* ===================================================================== *)
(* Proof guidance for forward secrecy                                    *)
(*                                                                       *)
(* Forward secrecy relies on:                                            *)
(* 1. IND-CCA2 of ephemeral KEM keys (not compromised)                  *)
(* 2. PRF of HKDF (key derived from KEM shared secrets)                 *)
(*                                                                       *)
(* EUF-CMA of signatures is NOT needed for forward secrecy —            *)
(* the signing keys are public_vars (compromised).                       *)
(* ===================================================================== *)

proof {
  crypto ind_cca2(HybridKEM) kem_seed_C;
  crypto ind_cca2(HybridKEM) kem_seed_S;
  crypto prf(HKDF_SHA384);
  simplify;
  success.
}
